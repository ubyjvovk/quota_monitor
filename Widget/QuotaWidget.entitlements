<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Widget extensions are always sandboxed. Without an App Group this one
	     cannot see the app's snapshot and renders its empty state. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
