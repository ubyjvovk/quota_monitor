<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The only channel through which the sandboxed widget can read the
	     snapshot written by the app. Requires a DEVELOPMENT_TEAM. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.quotamonitor.shared</string>
	</array>
</dict>
</plist>
